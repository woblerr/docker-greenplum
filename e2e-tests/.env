# GPDB
# -------------------------------------
IMAGE_NAME="greenplum"
# For GPDB 6 on Ubuntu 22.04
TAG=6.27.1
CONFIG_FOLDER="6"
# For GPDB 6 on Oracle Linux 8
#TAG=6.27.1-oraclelinux8
#CONFIG_FOLDER="6"
# For GPDB 7 on Ubuntu 22.04
#TAG=7.1.0
#CONFIG_FOLDER="7"
# For GPDB 7 on Oracle Linux 8
#TAG=7.1.0-oraclelinux8
#CONFIG_FOLDER="7"

# GPDB RESTORE
# -------------------------------------
# For GPDB 6 on Ubuntu 22.04
RESTORE_TAG=6.27.1
RESTORE_CONFIG_FOLDER="6"
# For GPDB 6 on Oracle Linux 8
#RESTORE_TAG=6.27.1-oraclelinux8
#RESTORE_CONFIG_FOLDER="6"
# For GPDB 7 on Ubuntu 22.04
#RESTORE_TAG=7.1.0
#RESTORE_CONFIG_FOLDER="7"
# For GPDB 7 on Oracle Linux 8
#RESTORE_TAG=7.1.0-oraclelinux8
#RESTORE_CONFIG_FOLDER="7"

